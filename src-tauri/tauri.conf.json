{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nishikanto",
  "version": "1.0.0",
  "identifier": "com.nishikanto.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nishikanto — AI Writing Assistant",
        "width": 1100,
        "height": 750,
        "minWidth": 800,
        "minHeight": 550,
        "resizable": true,
        "center": true,
        "visible": true
      },
      {
        "label": "widget",
        "title": "Nishikanto Widget",
        "width": 52,
        "height": 52,
        "minWidth": 40,
        "minHeight": 40,
        "maxWidth": 400,
        "maxHeight": 500,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "focusable": false,
        "skipTaskbar": true,
        "shadow": false,
        "url": "index.html?window=widget"
      },
      {
        "label": "underlines",
        "title": "Nishikanto Underlines",
        "fullscreen": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "focusable": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "url": "index.html?window=underlines"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
