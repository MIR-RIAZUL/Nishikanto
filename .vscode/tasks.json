{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "tauri dev",
      "type": "shell",
      "command": "npm run tauri dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Running BeforeDevCommand",
          "endsPattern": "VITE.*ready"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "tauri build",
      "type": "shell",
      "command": "npm run tauri build",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "cargo check",
      "type": "shell",
      "command": "cargo check --manifest-path src-tauri/Cargo.toml",
      "group": "test",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo test",
      "type": "shell",
      "command": "cargo test --manifest-path src-tauri/Cargo.toml",
      "group": "test",
      "problemMatcher": ["$rustc"]
    }
  ]
}
